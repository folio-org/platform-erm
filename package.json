    "@folio/notes": "~12.0.0",
    "@folio/oa": "~3.1.0",
    "@folio/orders": "~9.0.4",
    "@folio/organizations": "~7.0.0",
    "@folio/plugin-find-agreement": "~12.1.1",
    "@folio/plugin-find-eresource": "~8.1.1",
    "@folio/plugin-find-erm-usage-data-provider": "~7.1.0",
    "@folio/plugin-find-interface": "~6.1.0",
    "@folio/plugin-find-license": "~12.1.1",
    "@folio/plugin-find-organization": "~6.1.0",
    "@folio/plugin-find-package-title": "~7.1.0",
    "@folio/plugin-find-po-line": "~6.1.1",
    "@folio/plugin-find-user": "~8.1.0",
    "@folio/serials-management": "~2.1.1",
    "@folio/service-interaction": "~4.1.1",
    "@folio/stripes": "~10.1.4",
